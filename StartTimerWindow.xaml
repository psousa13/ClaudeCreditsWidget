<Window x:Class="ClaudeCreditsWidget.StartTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterScreen"
        Title="Start Timer" Width="280"
        FocusManager.FocusedElement="{Binding ElementName=TimeBox}">
    <StackPanel Margin="14,10,14,14">
        <TextBlock x:Name="EmailLabel" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
        <TextBlock Text="Available at (24h, e.g. 16:00)" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
        <TextBox x:Name="TimeBox" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="70" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Start" Width="70" Style="{StaticResource PrimaryButton}" Click="Start_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
