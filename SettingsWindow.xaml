<Window x:Class="ClaudeCreditsWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}"
        WindowStartupLocation="CenterScreen"
        Title="Widget Settings"
        Width="320">
    <StackPanel Margin="14,10,14,14">
        <Grid Margin="0,0,0,4">
            <TextBlock Text="Position X" Foreground="{StaticResource SubTextBrush}"/>
            <TextBlock x:Name="XLabel" HorizontalAlignment="Right" Foreground="{StaticResource SubTextBrush}"/>
        </Grid>
        <Slider x:Name="XSlider" Margin="0,0,0,12" IsMoveToPointEnabled="True" ValueChanged="Slider_ValueChanged"/>

        <Grid Margin="0,0,0,4">
            <TextBlock Text="Position Y" Foreground="{StaticResource SubTextBrush}"/>
            <TextBlock x:Name="YLabel" HorizontalAlignment="Right" Foreground="{StaticResource SubTextBrush}"/>
        </Grid>
        <Slider x:Name="YSlider" Margin="0,0,0,12" IsMoveToPointEnabled="True" ValueChanged="Slider_ValueChanged"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Width" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="WidthBox" TextChanged="SizeBox_TextChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Height" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="HeightBox" TextChanged="SizeBox_TextChanged"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Opacity (0 - 100)" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="64"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="OpacitySlider" Grid.Column="0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                    IsMoveToPointEnabled="True" ValueChanged="Slider_ValueChanged"/>
            <TextBox x:Name="OpacityBox" Grid.Column="2" TextChanged="OpacityBox_TextChanged"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="70" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="70" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
